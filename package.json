{
  "name": "research-output-dashboard",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Dashboard voor onderzoeksoutput, onderwijs en capaciteit; Cloudflare Workers + Access + D1 (EU)",
  "scripts": {
    "check:data": "tsx scripts/check-data.ts",
    "dev": "npm run check:data && vite",
    "dev:api": "vite build && wrangler dev",
    "build": "npm run check:data && npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p worker/tsconfig.json",
    "test": "tsx scripts/selftest.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "wrangler": "^4.157.0"
  }
}
