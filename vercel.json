{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Het dashboard draait op Cloudflare; niets te installeren.'",
  "buildCommand": "echo 'Het dashboard draait op Cloudflare; niets te bouwen.'",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://isdashboard.research-output.workers.dev/$1",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
